<Window x:Class="PromptHelper.Views.ConfirmDeleteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Delete Confirmation"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource AppBackgroundBrush}">
    <Border Background="{StaticResource SurfaceBrush}" Padding="24" CornerRadius="12" Margin="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <StackPanel>
            <TextBlock x:Name="TitleTextBlock"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,12"/>
            <TextBlock x:Name="MessageTextBlock"
                       FontSize="14"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"/>
            <TextBlock Text="This action cannot be undone."
                       FontSize="13"
                       Foreground="{StaticResource DangerBrush}"
                       Margin="0,0,0,24"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton"
                        Content="Cancel"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsCancel="True"
                        Click="CancelButton_Click"
                        Margin="0,0,12,0"/>
                <Button x:Name="ActionButton"
                        Content="Delete"
                        Style="{StaticResource DangerButtonStyle}"
                        Click="ActionButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>