<Window x:Class="PromptHelper.Views.NameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Name Dialog"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource AppBackgroundBrush}">
    <Border Background="{StaticResource SurfaceBrush}" Padding="24" CornerRadius="12" Margin="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <StackPanel>
            <TextBlock x:Name="TitleTextBlock"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,16"/>
            <TextBox x:Name="NameInputTextBox"
                     Style="{StaticResource ModernTextBoxStyle}"
                     KeyDown="NameInputTextBox_KeyDown"
                     Margin="0,0,0,8"/>
            <TextBlock x:Name="ErrorTextBlock"
                       FontSize="13"
                       Foreground="{StaticResource DangerBrush}"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"
                       Margin="0,0,0,16"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Cancel"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsCancel="True"
                        Click="CancelButton_Click"
                        Margin="0,0,12,0"/>
                <Button x:Name="ActionButton"
                        Content="Save"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="ActionButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>