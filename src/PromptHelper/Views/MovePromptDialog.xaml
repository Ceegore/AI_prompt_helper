<Window x:Class="PromptHelper.Views.MovePromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Move Prompt"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource AppBackgroundBrush}">
    <Border Background="{StaticResource SurfaceBrush}" Padding="24" CornerRadius="12" Margin="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="Move Prompt"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,12"/>

            <Border Background="{StaticResource AppBackgroundBrush}"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,0,16"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
                <TextBlock x:Name="PromptPreviewTextBlock"
                           FontSize="13"
                           FontFamily="{StaticResource MonospaceFontFamily}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"/>
            </Border>

            <TextBlock Text="Destination"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,6"/>

            <ComboBox x:Name="DestinationComboBox"
                      Style="{StaticResource ModernComboBoxStyle}"
                      DisplayMemberPath="DisplayPath"
                      SelectedValuePath="CategoryId"
                      Margin="0,0,0,16"/>

            <CheckBox x:Name="CopyInsteadOfMoveCheckBox"
                      Content="Copy instead of move"
                      Style="{StaticResource ModernCheckBoxStyle}"
                      Checked="CopyInsteadOfMoveCheckBox_Checked"
                      Unchecked="CopyInsteadOfMoveCheckBox_Unchecked"
                      Margin="0,0,0,8"/>

            <TextBlock x:Name="UnavailablePromptNoticeTextBlock"
                       Text="Unavailable prompts can be moved but cannot be duplicated."
                       FontSize="12"
                       Foreground="{StaticResource SubtleTextBrush}"
                       Visibility="Collapsed"
                       Margin="0,0,0,16"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Cancel"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsCancel="True"
                        Click="CancelButton_Click"
                        Margin="0,0,12,0"/>
                <Button x:Name="ActionButton"
                        Content="Move"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsDefault="True"
                        Click="ActionButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>