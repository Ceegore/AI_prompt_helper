<Window x:Class="PromptHelper.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tools &amp; Settings — Prompt Helper"
        Width="540"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource AppBackgroundBrush}">
    <Border Background="{StaticResource SurfaceBrush}" Padding="28" CornerRadius="12" Margin="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <StackPanel>
            <!-- Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Border Width="36" Height="36" Background="{StaticResource AccentBrush}" CornerRadius="10" Margin="0,0,12,0">
                    <TextBlock Text="P" Foreground="{StaticResource SurfaceBrush}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Prompt Helper" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Usage Hints -->
            <TextBlock Text="Choose a category to browse your prompt library."
                       FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
            <TextBlock Text="• Use + Add to create categories."
                       FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <TextBlock Text="• Use + Prompt to create prompts."
                       FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <TextBlock Text="• Use Copy to copy a prompt to the Windows clipboard."
                       FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16"/>

            <!-- Data Folder -->
            <TextBlock Text="Data folder:" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="DataFolderTextBox"
                         Grid.Column="0"
                         Style="{StaticResource ModernTextBoxStyle}"
                         IsReadOnly="True"
                         FontSize="12"
                         Margin="0,0,8,0"/>
                <Button Grid.Column="1"
                        Content="Browse…"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="BrowseButton_Click"
                        ToolTip="Select a different folder for Prompt Helper data"/>
            </Grid>

            <!-- Version -->
            <TextBlock Text="Version:" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,2"/>
            <TextBlock x:Name="VersionTextBlock"
                       FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,20"/>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsCancel="True"
                        Click="CancelButton_Click"
                        Margin="0,0,12,0"/>
                <Button Content="Save"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsDefault="True"
                        Click="SaveButton_Click"/>
            </StackPanel>

            <!-- Subtle Author Footer -->
            <TextBlock Text="Made by CeeGore"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource SubtleTextBrush}"
                       Opacity="0.75"
                       FontSize="12"
                       Margin="0,18,0,0"/>
        </StackPanel>
    </Border>
</Window>
