<Window x:Class="PromptHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PromptHelper.ViewModels"
        Title="Prompt Helper"
        Width="1100"
        Height="760"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Loaded="MainWindow_Loaded"
        Closed="MainWindow_Closed"
        PreviewKeyDown="Window_PreviewKeyDown"
        AutomationProperties.Name="Prompt Helper library"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="32,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" Background="{DynamicResource AccentBrush}" CornerRadius="10" Margin="0,0,12,0">
                        <TextBlock Text="P" Foreground="{DynamicResource SurfaceBrush}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Prompt Helper"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               AutomationProperties.HeadingLevel="Level1"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Button x:Name="SettingsButton"
                        Content="🔧"
                        Style="{StaticResource IconButtonStyle}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        ToolTip="Tools and settings"
                        AutomationProperties.Name="Tools and settings"
                        Click="SettingsButton_Click"/>
            </Grid>
        </Border>

        <!-- Recent Copies Quick Bar (Session only) -->
        <Border Grid.Row="1"
                Background="{DynamicResource AppBackgroundBrush}"
                Padding="32,5">
            <ItemsControl ItemsSource="{Binding RecentPrompts}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:RecentPromptViewModel}">
                        <Border Style="{StaticResource RecentPromptTileStyle}"
                                Margin="0,0,10,0"
                                Height="46">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Margin="0,0,8,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Text="{Binding Headline}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="1"
                                               Text="{Binding Excerpt}"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource SubtleTextBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                </Grid>

                                <Button Grid.Column="1"
                                        Content="{Binding CopyButtonText}"
                                        Style="{StaticResource CompactCopyButtonStyle}"
                                        Click="RecentPromptCopyButton_Click"
                                        ToolTip="Copy prompt"
                                        AutomationProperties.Name="{Binding Headline, StringFormat='Copy recent prompt: {0}'}"
                                        AutomationProperties.LiveSetting="Polite"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Main Body -->
        <Grid Grid.Row="2" Margin="32,16,32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Breadcrumb Navigation with Horizontal Scroll -->
            <ScrollViewer Grid.Row="0"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          Focusable="False"
                          Margin="0,0,0,16">
                <ItemsControl ItemsSource="{Binding Breadcrumbs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:BreadcrumbItemViewModel}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Clickable ancestor item -->
                                <Button x:Name="AncestorButton"
                                        Content="{Binding Name}"
                                        ToolTip="{Binding Name}"
                                        AutomationProperties.Name="{Binding Name, StringFormat='Navigate to category: {0}'}"
                                        Style="{StaticResource BreadcrumbButtonStyle}"
                                        Click="BreadcrumbButton_Click"/>
                                <!-- Separator -->
                                <TextBlock x:Name="AncestorSeparator"
                                           Text=" › "
                                           FontSize="14"
                                           Foreground="{DynamicResource SubtleTextBrush}"
                                           VerticalAlignment="Center"/>
                                <!-- Non-clickable current item -->
                                <TextBlock x:Name="CurrentText"
                                           Text="{Binding Name}"
                                           ToolTip="{Binding Name}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                    <Setter TargetName="AncestorButton" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="AncestorSeparator" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="CurrentText" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Categories Header -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <TextBlock Text="Categories"
                           FontSize="18"
                           FontWeight="Bold"
                           AutomationProperties.HeadingLevel="Level2"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
                <Button Content="+ _Add"
                        Style="{StaticResource SecondaryButtonStyle}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Add category"
                        ToolTip="Add category (Ctrl+Shift+N)"
                        Click="AddCategoryButton_Click"/>
            </Grid>

            <!-- Category Cards Area (MaxHeight 190) -->
            <ScrollViewer Grid.Row="2"
                          MaxHeight="190"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding ChildCategories}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CategoryItemViewModel}">
                            <Border Style="{StaticResource CardBorderStyle}"
                                    Width="230"
                                    Height="58"
                                    Padding="0"
                                    Margin="0,0,12,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Open Category Button with Ellipsis Text -->
                                    <Button Grid.Column="0"
                                            Style="{StaticResource CategoryOpenButtonStyle}"
                                            Click="OpenCategoryButton_Click"
                                            AutomationProperties.Name="{Binding Name, StringFormat='Open category: {0}'}"
                                            ToolTip="{Binding Name}">
                                        <TextBlock Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                    </Button>

                                    <!-- Action Button (Wrench overlay) -->
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="0,0,8,0">
                                        <Button x:Name="CategoryActionsButton"
                                                Content="🔧"
                                                Style="{StaticResource IconButtonStyle}"
                                                ToolTip="Category actions"
                                                AutomationProperties.Name="{Binding Name, StringFormat='Category actions: {0}'}"
                                                Click="CategoryActionsButton_Click">
                                            <Button.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="✎ Rename"
                                                              Click="RenameCategoryMenuItem_Click"/>
                                                    <MenuItem Header="× Delete"
                                                              Click="DeleteCategoryMenuItem_Click"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Divider -->
            <Border Grid.Row="3"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    VerticalAlignment="Center"/>

            <!-- Prompts Header -->
            <Grid Grid.Row="4" Margin="0,0,0,12">
                <TextBlock Text="Prompts"
                           FontSize="18"
                           FontWeight="Bold"
                           AutomationProperties.HeadingLevel="Level2"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
                <Button Content="+ _Prompt"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Create prompt"
                        ToolTip="Create prompt (Ctrl+N)"
                        Click="AddPromptButton_Click"/>
            </Grid>

            <!-- Prompts List Box (3-Cards-Per-Row Grid) -->
            <Grid Grid.Row="5">
                <!-- Empty state message -->
                <TextBlock Text="No prompts in this category."
                           FontSize="14"
                           Foreground="{DynamicResource SubtleTextBrush}"
                           FontStyle="Italic"
                           AutomationProperties.LiveSetting="Polite"
                           Margin="0,16,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasNoPrompts}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Virtualized prompt rows; each realized row contains up to three cards. -->
                <ListBox ItemsSource="{Binding PromptRows}"
                         ItemContainerStyle="{StaticResource PromptGridListBoxItemStyle}"
                         AutomationProperties.Name="Prompts in current category"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.Style>
                        <Style TargetType="ListBox">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasPrompts}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Style>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PromptRowViewModel}">
                            <ItemsControl ItemsSource="{Binding Prompts}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Margin" Value="0,0,12,12"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PromptCardViewModel}">
                                        <Border Style="{StaticResource CardBorderStyle}"
                                                AutomationProperties.Name="{Binding PreviewTitle, StringFormat='Prompt: {0}'}"
                                                AutomationProperties.HelpText="{Binding LoadError}"
                                                ToolTipService.InitialShowDelay="500"
                                                ToolTipService.ShowDuration="60000">
                                            <Border.ToolTip>
                                                <ToolTip MaxWidth="700"
                                                         MaxHeight="480"
                                                         Padding="0">
                                                    <Border Background="{DynamicResource SurfaceBrush}"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="14">
                                                        <ScrollViewer MaxHeight="440"
                                                                      VerticalScrollBarVisibility="Auto"
                                                                      HorizontalScrollBarVisibility="Disabled">
                                                            <TextBlock Text="{Binding DisplayText}"
                                                                       FontFamily="{StaticResource MonospaceFontFamily}"
                                                                       FontSize="13"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       TextWrapping="Wrap"/>
                                                        </ScrollViewer>
                                                    </Border>
                                                </ToolTip>
                                            </Border.ToolTip>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0"
                                                           Text="{Binding PreviewTitle}"
                                                           FontSize="14"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,0,0,10"/>

                                                <UniformGrid Grid.Row="1"
                                                             Columns="4"
                                                             Margin="0,0,0,10">
                                                    <Button Content="Delete"
                                                            Style="{StaticResource CompactActionButtonStyle}"
                                                            AutomationProperties.Name="{Binding PreviewTitle, StringFormat='Delete prompt: {0}'}"
                                                            Click="DeletePromptButton_Click"/>
                                                    <Button Content="Edit"
                                                            Style="{StaticResource CompactActionButtonStyle}"
                                                            AutomationProperties.Name="{Binding PreviewTitle, StringFormat='Edit prompt: {0}'}"
                                                            IsEnabled="{Binding IsContentAvailable}"
                                                            Click="EditPromptButton_Click"/>
                                                    <Button Content="Move"
                                                            Style="{StaticResource CompactActionButtonStyle}"
                                                            AutomationProperties.Name="{Binding PreviewTitle, StringFormat='Move prompt: {0}'}"
                                                            Click="MovePromptButton_Click"/>
                                                    <Button Content="{Binding CopyButtonText}"
                                                            Style="{StaticResource CompactActionButtonStyle}"
                                                            AutomationProperties.Name="{Binding PreviewTitle, StringFormat='Copy prompt: {0}'}"
                                                            AutomationProperties.LiveSetting="Polite"
                                                            IsEnabled="{Binding IsContentAvailable}"
                                                            Click="CopyPromptButton_Click"/>
                                                </UniformGrid>

                                                <TextBlock Grid.Row="2"
                                                           Text="{Binding DisplayText}"
                                                           FontFamily="{StaticResource MonospaceFontFamily}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextWrapping="Wrap"
                                                           MaxHeight="110"
                                                           ClipToBounds="True"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </Grid>
</Window>
