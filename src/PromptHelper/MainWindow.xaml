<Window x:Class="PromptHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PromptHelper.ViewModels"
        Title="Prompt Helper"
        Width="1100"
        Height="760"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="32,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" Background="{StaticResource AccentBrush}" CornerRadius="10" Margin="0,0,12,0">
                        <TextBlock Text="P" Foreground="{StaticResource SurfaceBrush}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Prompt Helper" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <Button x:Name="HelpButton"
                        Content="?"
                        Style="{StaticResource IconButtonStyle}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        ToolTip="Help"
                        AutomationProperties.Name="Help"
                        Click="HelpButton_Click"/>
            </Grid>
        </Border>

        <!-- Main Body -->
        <Grid Grid.Row="1" Margin="32,20,32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Breadcrumb Navigation -->
            <ItemsControl Grid.Row="0" ItemsSource="{Binding Breadcrumbs}" Margin="0,0,0,16">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:BreadcrumbItemViewModel}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Clickable ancestor item -->
                            <Button x:Name="AncestorButton"
                                    Content="{Binding Name}"
                                    Style="{StaticResource BreadcrumbButtonStyle}"
                                    Click="BreadcrumbButton_Click"/>
                            <!-- Separator -->
                            <TextBlock x:Name="AncestorSeparator"
                                       Text=" › "
                                       FontSize="14"
                                       Foreground="{StaticResource SubtleTextBrush}"
                                       VerticalAlignment="Center"/>
                            <!-- Non-clickable current item -->
                            <TextBlock x:Name="CurrentText"
                                       Text="{Binding Name}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="AncestorButton" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="AncestorSeparator" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="CurrentText" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Categories Header -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <TextBlock Text="Categories"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
                <Button Content="+ Add"
                        Style="{StaticResource SecondaryButtonStyle}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Click="AddCategoryButton_Click"/>
            </Grid>

            <!-- Category Cards Area (MaxHeight 190) -->
            <ScrollViewer Grid.Row="2"
                          MaxHeight="190"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding ChildCategories}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CategoryItemViewModel}">
                            <Border Style="{StaticResource CardBorderStyle}"
                                    Width="230"
                                    Height="58"
                                    Padding="0"
                                    Margin="0,0,12,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Open Category Button -->
                                    <Button Grid.Column="0"
                                            Content="{Binding Name}"
                                            Style="{StaticResource CategoryOpenButtonStyle}"
                                            Click="OpenCategoryButton_Click"
                                            ToolTip="Open category"/>

                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="0,0,8,0">
                                        <Button Content="✎"
                                                Style="{StaticResource IconButtonStyle}"
                                                ToolTip="Rename category"
                                                AutomationProperties.Name="Rename category"
                                                Click="RenameCategoryButton_Click"/>
                                        <Button Content="×"
                                                Style="{StaticResource IconButtonStyle}"
                                                ToolTip="Delete category"
                                                AutomationProperties.Name="Delete category"
                                                Click="DeleteCategoryButton_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Divider -->
            <Border Grid.Row="3"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    VerticalAlignment="Center"/>

            <!-- Prompts Header -->
            <Grid Grid.Row="4" Margin="0,0,0,12">
                <TextBlock Text="Prompts"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
                <Button Content="+ Prompt"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Click="AddPromptButton_Click"/>
            </Grid>

            <!-- Prompts List Box -->
            <Grid Grid.Row="5">
                <!-- Empty state message -->
                <TextBlock Text="No prompts in this category."
                           FontSize="14"
                           Foreground="{StaticResource SubtleTextBrush}"
                           FontStyle="Italic"
                           Margin="0,16,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasNoPrompts}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Virtualizing ListBox -->
                <ListBox ItemsSource="{Binding Prompts}"
                         ItemContainerStyle="{StaticResource FlatListBoxItemStyle}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.Style>
                        <Style TargetType="ListBox">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasPrompts}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Style>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PromptCardViewModel}">
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Top Card Bar -->
                                    <Grid Grid.Row="0" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Derived Preview Title -->
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding PreviewTitle}"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,16,0"/>

                                        <!-- Action Buttons -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Delete"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Click="DeletePromptButton_Click"
                                                    Margin="0,0,8,0"/>
                                            <Button Content="Edit"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    IsEnabled="{Binding IsContentAvailable}"
                                                    Click="EditPromptButton_Click"
                                                    Margin="0,0,8,0"/>
                                            <Button Content="Move"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Click="MovePromptButton_Click"
                                                    Margin="0,0,8,0"/>
                                            <Button Content="{Binding CopyButtonText}"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    IsEnabled="{Binding IsContentAvailable}"
                                                    Click="CopyPromptButton_Click"
                                                    MinWidth="78"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Prompt Content -->
                                    <TextBox Grid.Row="1"
                                             Text="{Binding DisplayText, Mode=OneWay}"
                                             Style="{StaticResource PromptDisplayTextBoxStyle}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </Grid>
</Window>