<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PromptHelper.Desktop</RootNamespace>
    <AssemblyName>PromptHelper</AssemblyName>
    <Version>0.5.0</Version>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../PromptHelper.Core/PromptHelper.Core.csproj" />
    <ProjectReference Include="../PromptHelper.Platform.Linux/PromptHelper.Platform.Linux.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PromptHelper.Platform.Linux.Tests" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="../PromptHelper/Assets/PromptHelperLogo.svg"
                      Link="Assets/PromptHelperLogo.svg" />
    <Content Include="../../LICENSE" Link="LICENSE">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="../../THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
